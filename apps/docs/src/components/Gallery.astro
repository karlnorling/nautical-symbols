---
import { getAllSymbols } from '@nautical-symbols/core';

const symbols = getAllSymbols();

const categories: { id: string; label: string; color: string }[] = [
  { id: 'letter-flags', label: 'Letter flags', color: '#1f4e79' },
  { id: 'number-pennants', label: 'Number pennants', color: '#2980b9' },
  { id: 'nato-number-flags', label: 'NATO number flags', color: '#16a085' },
  { id: 'special-pennants', label: 'Answer & substitutes', color: '#8e44ad' },
  { id: 'cardinal-marks', label: 'Cardinal marks', color: '#2c3e50' },
  { id: 'lateral-marks', label: 'Lateral marks', color: '#c0392b' },
  { id: 'isolated-danger-marks', label: 'Isolated danger', color: '#7f1d1d' },
  { id: 'special-marks', label: 'Special marks', color: '#b7950b' },
  { id: 'beacons', label: 'Beacons', color: '#6d4c41' },
  { id: 'topmarks', label: 'Topmarks', color: '#27ae60' },
  { id: 'lights', label: 'Lights', color: '#d35400' },
  { id: 'dangers', label: 'Dangers', color: '#7b241c' },
  { id: 'areas', label: 'Areas', color: '#5b2c6f' },
  { id: 'harbour', label: 'Harbour', color: '#117a65' },
  { id: 'other', label: 'Other', color: '#566573' },
];
---

<div class="gallery">
  <div class="gallery-controls">
    <input
      type="search"
      id="gallery-search"
      placeholder="Search by name or code…"
      aria-label="Search symbols"
    />
    <div class="category-filters" role="group" aria-label="Filter by category">
      {
        categories.map((cat) => (
          <button
            class="filter-btn"
            data-category={cat.id}
            style={`--cat-color: ${cat.color}`}
            aria-pressed="false"
          >
            {cat.label}
            <span class="count">({symbols.filter((s) => s.category === cat.id).length})</span>
          </button>
        ))
      }
    </div>
  </div>

  <p class="gallery-count" id="gallery-count">{symbols.length} symbols</p>

  <div class="symbol-grid" id="symbol-grid">
    {
      symbols.map((symbol) => (
        <div
          class="symbol-card"
          data-category={symbol.category}
          data-name={symbol.name.toLowerCase()}
          data-code={symbol.code.toLowerCase()}
          title={symbol.description}
        >
          <div class="symbol-svg" set:html={symbol.svg} />
          <span class="symbol-code">{symbol.code}</span>
          <span class="symbol-name">{symbol.name}</span>
        </div>
      ))
    }
  </div>
</div>

<style>
  .gallery-controls {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  #gallery-search {
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.375rem;
    background: var(--sl-color-bg);
    color: var(--sl-color-text);
    font-size: 0.9rem;
    width: 100%;
    max-width: 380px;
    outline-offset: 2px;
  }

  #gallery-search:focus {
    outline: 2px solid var(--sl-color-accent);
  }

  .category-filters {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .filter-btn {
    margin-top: 0;
    padding: 0.3rem 0.85rem;
    border-radius: 999px;
    border: 1.5px solid var(--cat-color, var(--sl-color-gray-5));
    background: transparent;
    color: var(--sl-color-text);
    cursor: pointer;
    font-size: 0.8rem;
    transition:
      background 0.15s,
      color 0.15s;
    display: flex;
    align-items: center;
    gap: 0.3rem;
  }

  .filter-btn .count {
    font-size: 0.72rem;
    opacity: 0.7;
  }

  .filter-btn[aria-pressed='true'] {
    background: var(--cat-color);
    color: #fff;
    border-color: var(--cat-color);
  }

  .filter-btn[aria-pressed='true'] .count {
    opacity: 0.9;
  }

  .gallery-count {
    font-size: 0.8rem;
    color: var(--sl-color-gray-3);
    margin: 0 0 1rem;
  }

  .symbol-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(110px, 1fr));
    gap: 0.75rem;
  }

  .symbol-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.2rem;
    margin-top: 0;
    padding: 0.75rem 0.5rem 0.5rem;
    border-radius: 0.5rem;
    border: 1px solid var(--sl-color-gray-6);
    background: var(--sl-color-bg-sidebar);
    transition: border-color 0.15s;
    cursor: default;
  }

  .symbol-card:hover {
    border-color: var(--sl-color-accent);
  }

  .symbol-card.hidden {
    display: none;
  }

  /* Some symbols are black line art: give them a light
     tile so they stay legible in the dark theme. */
  .symbol-svg {
    background: #fff;
    border-radius: 4px;
    padding: 4px;
  }

  .symbol-svg :global(svg) {
    width: 56px;
    height: 56px;
    display: block;
  }

  .symbol-code {
    font-family: var(--sl-font-mono);
    font-size: 0.65rem;
    color: var(--sl-color-gray-3);
    margin-top: 0.3rem;
  }

  .symbol-name {
    font-size: 0.68rem;
    text-align: center;
    color: var(--sl-color-gray-2);
    line-height: 1.3;
  }
</style>

<script>
  const searchInput = document.getElementById('gallery-search') as HTMLInputElement;
  const grid = document.getElementById('symbol-grid')!;
  const countEl = document.getElementById('gallery-count')!;
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  let activeCategory: string | null = null;

  function update() {
    const q = searchInput.value.toLowerCase().trim();
    let visible = 0;
    grid.querySelectorAll<HTMLElement>('.symbol-card').forEach((card) => {
      const matchesSearch =
        !q || card.dataset.name!.includes(q) || card.dataset.code!.includes(q);
      const matchesCategory = !activeCategory || card.dataset.category === activeCategory;
      const show = matchesSearch && matchesCategory;
      card.classList.toggle('hidden', !show);
      if (show) visible++;
    });
    const noun = visible === 1 ? 'symbol' : 'symbols';
    countEl.textContent = `${visible} ${noun}`;
  }

  searchInput.addEventListener('input', update);

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const cat = btn.dataset.category!;
      activeCategory = activeCategory === cat ? null : cat;
      filterBtns.forEach((b) => {
        b.setAttribute('aria-pressed', String(b.dataset.category === activeCategory));
      });
      update();
    });
  });
</script>
